{
  "name": "monitor-theme-1999",
  "version": "1.7.2",
  "description": "Monitor 1999 —— 极简探针（Monitor）的新粗野主义风格主题，前身来自 r1cebucket/komari-theme-1999。",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "akanotanin / r1cebucket",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "vendor": "node scripts/vendor-assets.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-defaults.mjs && node scripts/check-adapt.mjs",
    "verify": "node scripts/verify-layout.mjs",
    "verify:hub141": "node scripts/verify-hub141.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "preview": "node scripts/serve.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('release',{recursive:true,force:true})\""
