{
  "name": "Monitor 1999",
  "short": "1999",
  "description": "极简探针（Monitor）的新粗野主义风格主题，前身来自 ricebucket/komari-theme-1999。",
  "version": "1.4.0",
  "author": "akanotanin",
  "url": "https://github.com/akanotanin/monitor-theme-1999",
  "config": [
    {
      "type": "title",
      "label": "外观"
    },
    {
      "type": "select",
      "key": "accentColor",
      "label": "强调色",
      "default": "yellow",
      "options": [
        {
          "value": "yellow",
          "label": "yellow"
        },
        {
          "value": "red",
          "label": "red"
        },
        {
          "value": "blue",
          "label": "blue"
        },
        {
          "value": "green",
          "label": "green"
        },
        {
          "value": "purple",
          "label": "purple"
        }
      ],
      "help": "页头与高亮区块的强调色"
    },
    {
      "type": "select",
      "key": "cardStyle",
      "label": "卡片边框风格",
      "default": "thick",
      "options": [
        {
          "value": "thick",
          "label": "thick"
        },
        {
          "value": "thin",
          "label": "thin"
        },
        {
          "value": "double",
          "label": "double"
        }
      ],
      "help": "节点卡片的边框：thick 粗边 / thin 细边 / double 双线"
    },
    {
      "type": "title",
      "label": "卡片与视图"
    },
    {
      "type": "select",
      "key": "defaultViewMode",
      "label": "默认视图",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "grid（卡片）"
        },
        {
          "value": "list",
          "label": "list（列表）"
        }
      ],
      "help": "访客首次打开首页时的视图；访客自己切过之后以访客为准"
    },
    {
      "type": "select",
      "key": "cardGroupView",
      "label": "卡片视图的分组展示",
      "default": "tabs",
      "options": [
        {
          "value": "tabs",
          "label": "tabs（只有顶栏分组标签）"
        },
        {
          "value": "sections",
          "label": "sections（分组标签 + 分段标题）"
        },
        {
          "value": "none",
          "label": "none（不显示分组按钮）"
        }
      ],
      "help": "tabs 只留顶栏标签（默认）/ sections 再加分段标题 / none 两个视图都不显示标签行；列表视图始终按分组分段"
    },
    {
      "type": "boolean",
      "key": "showNodePing",
      "label": "卡片显示三网延迟",
      "default": true,
      "help": "在卡片底部显示探测线路的最新延迟与丢包率（最多 3 条，名字取自 Hub 后台的探测任务名）。关掉后访客页面不再请求延迟数据"
    },
    {
      "type": "text",
      "key": "cardPingLines",
      "label": "卡片显示哪几条探测线路",
      "default": "",
      "help": "每行一个线路名（也可用逗号分隔），按填写顺序显示；留空 = 自动取有数据的前 3 条。名字要照抄 Hub 后台的探测任务名，对不上会被跳过"
    },
    {
      "type": "select",
      "key": "cardPingLayout",
      "label": "卡片延迟的排布",
      "default": "columns",
      "options": [
        {
          "value": "rows",
          "label": "rows（每条线路一行，竖排）"
        },
        {
          "value": "columns",
          "label": "columns（三条线路并排，横排）"
        }
      ],
      "help": "columns 三条线路并排成三列（卡片更矮）/ rows 每条占一行。只影响卡片视图"
    },
    {
      "type": "title",
      "label": "成本卡片"
    },
    {
      "type": "boolean",
      "key": "showCostMonthCard",
      "label": "显示每月成本",
      "default": true,
      "help": "左栏 COST / MONTH：按价格与付款周期折算出的每月固定支出，与到期时间无关"
    },
    {
      "type": "boolean",
      "key": "showCostCard",
      "label": "显示剩余价值",
      "default": true,
      "help": "右栏 RESIDUAL VALUE：还没用掉的预付金额，7 天内到期的节点做成红色印章。关掉后这一栏与到期提醒都不显示"
    },
    {
      "type": "select",
      "key": "costCurrency",
      "label": "结算货币",
      "default": "CNY",
      "options": [
        {
          "value": "CNY",
          "label": "CNY（¥）"
        },
        {
          "value": "USD",
          "label": "USD（$）"
        },
        {
          "value": "EUR",
          "label": "EUR（€）"
        },
        {
          "value": "GBP",
          "label": "GBP（£）"
        },
        {
          "value": "JPY",
          "label": "JPY（¥）"
        }
      ],
      "help": "汇总用的货币；节点填的货币与它不同时按汇率折算"
    },
    {
      "type": "text",
      "key": "costRates",
      "label": "汇率表",
      "default": "",
      "help": "留空 = 用主题内置的参考汇率（带日期与来源的快照）；填了则同名币种覆盖内置值。每行 `货币=汇率`（例：1 USD = 7.2 CNY）"
    },
    {
      "type": "title",
      "label": "运行"
    },
    {
      "type": "number",
      "key": "dataUpdateInterval",
      "label": "数据刷新间隔",
      "default": 3,
      "min": 1,
      "max": 60,
      "help": "实时数据的刷新间隔，单位秒（建议 2-10）"
    },
    {
      "type": "boolean",
      "key": "showLoginButton",
      "label": "显示后台入口按钮",
      "default": true,
      "help": "未登录的访客是否显示顶栏的后台入口按钮（点击跳转 /admin）"
    }
  ]
}
